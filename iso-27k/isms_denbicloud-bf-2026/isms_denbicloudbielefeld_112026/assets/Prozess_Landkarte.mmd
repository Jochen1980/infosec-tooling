    classDef y stroke:#0d0
    classDef z stroke:#00d
    classDef x3 stroke:#d00,stroke-width:3px
    classDef y3 stroke:#0d0,stroke-width:3px
    classDef z3 stroke:#00d,stroke-width:3px
