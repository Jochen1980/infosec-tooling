    B[Betrieb]:::x3 --> A
    C[Ressourcen]:::x --> B
    D[Personal]:::w
    E[Hardware]:::x --> C
    F[Software]:::x --> C
    %%G[BRF] --> D
    %%H[ADM] --> D
    D -.->|pflegt| E
    D -.->|pflegt| J
    D -.->|betreibt| F
    I[ISMS]:::y3 --> A
